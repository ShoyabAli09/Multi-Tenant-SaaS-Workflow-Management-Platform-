# Django Environment Configuration
DEBUG=True
SECRET_KEY=generate-a-strong-secret-key-for-production-use-2026
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, sqlite for local tests)
DB_ENGINE=postgresql
POSTGRES_DB=saas_workflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Caching Configuration
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=False

# JWT Token Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# AWS Deployment Environment Settings (EC2 / RDS / ElastiCache / S3)
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=saas-workflow-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

